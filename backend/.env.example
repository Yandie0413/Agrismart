# Serveur
PORT=3000

# Base de données MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=agri_db

# Email (OTP 2FA + reinitialisation de mot de passe), via l'API HTTPS de Resend (resend.com) -
# le SMTP direct (Gmail) ne fonctionne pas depuis Railway (port sortant bloque, ETIMEDOUT).
RESEND_API_KEY=votre_cle_api_resend
# Optionnel : adresse d'expedition. Par defaut, l'adresse bac a sable "onboarding@resend.dev"
# (ne peut envoyer qu'a l'adresse du compte Resend tant qu'aucun domaine n'est verifie).
EMAIL_FROM=AgriSmart <onboarding@resend.dev>

# URL du site web deploye (utilisee dans le lien de reinitialisation de mot de passe envoye par email)
FRONTEND_URL=https://front-omega-orpin.vercel.app

# JWT
JWT_SECRET=une_cle_secrete_longue_et_complexe
JWT_EXPIRES_IN=7d

# Meteo (OpenWeatherMap)
OPENWEATHER_API_KEY=votre_cle_api_openweathermap